# URL base da API do backend NestJS
VITE_API_URL=http://localhost:3000/api

# URL do servidor Socket.io (namespace /realtime é adicionado no código)
VITE_SOCKET_URL=http://localhost:3000

# Chave do Google Maps JavaScript SDK (usada no PRÓXIMO passo - mapa/rota)
VITE_GOOGLE_MAPS_API_KEY=

# Servidor OSRM usado pelo mapa para desenhar o traçado da rota (sem chave).
VITE_OSRM_URL=https://router.project-osrm.org

# Ponto de partida usado quando o entregador nega o GPS. Deve ficar dentro da
# area de operacao — um padrao em outra cidade gera rota de centenas de km.
VITE_PARTIDA_PADRAO=-3.7327,-38.5267
