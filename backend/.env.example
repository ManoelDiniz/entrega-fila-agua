# ==== Banco de dados (MySQL local do Windows) ====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=troque_pela_sua_senha
DB_NAME=entrega_fila_agua

# ==== Servidor ====
PORT=3000
# Origem permitida para CORS / Socket.io (frontend Vite)
CORS_ORIGIN=http://localhost:5173

# ==== Auth (JWT) ====
JWT_SECRET=troque_por_um_segredo_bem_grande_e_aleatorio
JWT_EXPIRES_IN=8h

# ==== Google Maps (usado no PRÓXIMO passo - otimização de rota) ====
# Chave do lado do servidor para a Routes API
GOOGLE_MAPS_API_KEY=

# ==== Roteamento (otimização da rota do lote) ====
# Provedor: "osrm" (padrão, gratuito, sem chave) ou "google" (exige chave+billing).
ROTA_PROVIDER=osrm
# Servidor OSRM. O público é um DEMO: sem SLA e com rate limit — não use em
# produção. Para produção suba o seu (docker run osrm/osrm-backend) e aponte aqui.
OSRM_URL=https://router.project-osrm.org
# Velocidade média usada só no fallback Haversine (quando o roteador cai).
ROTA_VELOCIDADE_KMH=25

# ==== Geocodificação (endereço -> lat/lng) ====
# Provedor: "nominatim" (padrão, gratuito) ou "google".
GEO_PROVIDER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
# A política do Nominatim público EXIGE um User-Agent que te identifique.
NOMINATIM_USER_AGENT=entrega-fila-agua/0.1 (contato: troque-pelo-seu-email)
# Restringe a busca de endereços a um país (código ISO). Vazio = mundo todo.
GEO_COUNTRY=br
# Cerca geográfica da geocodificação: lon_min,lat_min,lon_max,lat_max
# Endereço vago ("Av. Central, 1000") casa com rua homônima em outro estado e
# devolve coordenada ERRADA com cara de certa. Com a viewbox, o que cai fora da
# área de operação é recusado: o cliente fica sem coordenada (falha visível) em
# vez de com a coordenada errada (falha silenciosa).
# Area de operacao real: Fortaleza + Caucaia (limites dos municipios + folga).
GEO_VIEWBOX=-39.0195,-4.0149,-38.3813,-3.5286

# ViaCEP (CEP -> rua/bairro/cidade). Gratuito, sem chave.
VIACEP_URL=https://viacep.com.br

# Nome legivel da area de entrega (mostrado ao atendente).
GEO_CIDADES=Fortaleza e Caucaia
